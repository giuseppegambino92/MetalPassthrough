# Minimal runtime image for MetalPassthrough end-to-end tests (no NVIDIA software inside).
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends python3 python3-pip python3-numpy && \
    pip3 install --no-cache-dir "numpy==2.2.6" && pip3 install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    rm -rf /var/lib/apt/lists/*
